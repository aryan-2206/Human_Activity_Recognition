# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Python cache ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
.Python

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Large data files (share via Google Drive) ──────────────────────────────────
data/raw/
data/processed/*.npy
data/processed/*.joblib
# keep the placeholder so git tracks the empty directory
!data/processed/.gitkeep

# ── Trained model weights — keep the small ones, ignore if regenerated locally ─
# models/*.keras and models/*.joblib are intentionally tracked (all < 50 MB).
# Uncomment the lines below if you want to stop tracking them:
# models/*.keras
# models/*.joblib

# ── Build / dist ───────────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
*.whl

# ── Testing / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# ── Type-checker / linter caches ───────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Matplotlib / Keras local caches ────────────────────────────────────────────
.cache/
.keras/

# ── OS / IDE ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ── Colab / Google auth ────────────────────────────────────────────────────────
*.json
!results/*.json
# keep result JSON files

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary / scratch files ──────────────────────────────────────────────────
*.tmp
*.bak
_fix_*.py
_verify.py
scratch/
